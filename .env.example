# Public site URL (sponsor checkout return, etc.)
NEXT_PUBLIC_APP_URL=https://tarhak.ir

# Supabase (auth + component metadata + copy events)
NEXT_PUBLIC_SUPABASE_URL=
# Prefer publishable key; anon key also works
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: admin metadata sync from filesystem writes
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token (https://supabase.com/dashboard/account/tokens)
# Used only by: npm run push:auth-emails
# SUPABASE_ACCESS_TOKEN=
